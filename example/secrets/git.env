# Read only by the git proxy. Scope the token to the repos the agent should reach
# (contents:write and pull_requests:write); branch protection is the merge gate.
GITHUB_TOKEN=
GIT_CONFIG_COUNT=3
GIT_CONFIG_KEY_0=user.name
GIT_CONFIG_VALUE_0=my-agent
GIT_CONFIG_KEY_1=user.email
GIT_CONFIG_VALUE_1=my-agent@example.com
GIT_CONFIG_KEY_2=credential.https://github.com.helper
GIT_CONFIG_VALUE_2=!f() { echo username=x-access-token; echo password=$GITHUB_TOKEN; }; f
