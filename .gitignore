# per-user config
.env
.gitconfig
skills.conf
zshrc
vimrc

# runtime state
tools/md2html/node_modules/
workspaces.conf

# pre-1.0 live mounts; state now lives under ~/.tau
scripts/
workspace/

# pi-config is mostly runtime state + user customization, but tau-standard
# functionality (skills, extensions, seeded config) ships with the repo.
# Ladder of negations: a parent dir must be un-ignored before its children can be.
pi-config/*
!pi-config/agent
pi-config/agent/*

# tau-standard skills (user-added skills stay ignored)
!pi-config/agent/skills
pi-config/agent/skills/*
!pi-config/agent/skills/tau
!pi-config/agent/skills/tau-runtime
!pi-config/agent/skills/tau-git-shipping
!pi-config/agent/skills/subagent-sessions
!pi-config/agent/skills/glossary-maintenance
!pi-config/agent/skills/index-maintenance
!pi-config/agent/skills/review-local-code
!pi-config/agent/skills/tau-share
!pi-config/agent/skills/tau-live-debug
!pi-config/agent/skills/tau-annotate
!pi-config/agent/skills/tau-slack

# tau-standard extensions (user-added ones — status lines etc. — stay ignored)
!pi-config/agent/extensions
pi-config/agent/extensions/*
!pi-config/agent/extensions/tau-awareness.ts
!pi-config/agent/extensions/git-guard.ts
!pi-config/agent/extensions/share-tools
!pi-config/agent/extensions/glossary-awareness.ts
!pi-config/agent/extensions/index-awareness.ts
!pi-config/agent/extensions/todos.ts
!pi-config/agent/extensions/workspace-tools
!pi-config/agent/extensions/subagent-sessions
!pi-config/agent/extensions/tau-splash.ts
!pi-config/agent/extensions/live-bridge

# seeded treehouse config (hooks are commented examples; user edits are theirs
# to commit or not)
!pi-config/agent/treehouse

.DS_Store

# built by `make`
/tau
