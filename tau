#!/usr/bin/env bash
# tau — CLI for the Pi Coding Agent sandbox container.
#
#   tau start | stop | restart | shell | env | refresh
#   tau session new [--name NAME] | list | kill <id> | attach <id>
#
# Credential model: the container reads AWS creds from a file on a container-only
# tmpfs (AWS_SHARED_CREDENTIALS_FILE, set in the image). The host resolves fresh
# readonly-scoped temp creds and pipes them in — never onto host disk. `refresh`
# rewrites that file, so a long-lived container survives cred expiry without
# losing running Pi sessions. PI_AWS_PROFILE is optional: omit it to run without
# AWS access; set it (at start, session, shell, or refresh) to push creds in.
set -euo pipefail

# Resolve SELF through symlinks so `tau` works when symlinked onto PATH.
__src="${BASH_SOURCE[0]}"
while [[ -h "$__src" ]]; do
  __dir="$(cd -P "$(dirname "$__src")" && pwd)"
  __src="$(readlink "$__src")"
  [[ "$__src" != /* ]] && __src="$__dir/$__src"
done
SELF="$(cd -P "$(dirname "$__src")" && pwd)"
CONTAINER="tau"
IMAGE="tau:latest"
PROFILE="${PI_AWS_PROFILE:-}"
SCRIPTS="${PI_SCRIPTS:-$SELF/scripts}"
WORKSPACE="${PI_WORKSPACE:-$SELF/workspace}"
PI_CONFIG="${PI_CONFIG:-$SELF/pi-config}"    # host mount for Pi's global ~/.pi
SKILLS_CONF="${PI_SKILLS_CONF:-$SELF/skills.conf}"   # host skill dirs to mount
WORKSPACES_FILE="${PI_WORKSPACES_FILE:-$SELF/workspaces.conf}"   # registry: <uuid>\t<path>
REGION="${AWS_REGION:-us-east-1}"
PI_CMD="${PI_CMD:-pi}"                       # command that starts a Pi conversation
CRED_DIR="/home/pi/.tau"
CRED_FILE="$CRED_DIR/credentials"
TMUX=(tmux -L tau -f /etc/tau/tmux.conf)     # dedicated socket + minimal config

usage() {
  cat <<'EOF'
tau — sandbox CLI for the Pi Coding Agent container.

Usage: tau <command> [args]

Container:
  start              run or resume the container, push fresh creds
  stop               stop the container (sessions lost)
  restart            restart if running, else noop (sessions lost)
  shell              open an interactive zsh
  refresh            re-push fresh temp creds without a restart
  env                edit the scoped-token .env in $EDITOR
  config             edit Pi's global settings.json in $EDITOR
  skills [list]      edit skills.conf (host dirs mounted into Pi), or list mounts

Workspaces (copied into the live-mounted workspace/ — instant, no restart):
  workspace add [dir] [--name NAME] [--cd] [--live]
                              copy dir (default PWD) into /workspace/<name>; edits stay in the
                              copy. --live: bind-mount your real source read/write (shared, no
                              isolation), applies on next 'tau restart'. --name defaults to
                              the dir basename.
  workspace list              name, id, mode, container path, source
  workspace remove <name|id>  delete the copy, or unregister a live mount (source untouched;
                              a live mount unmounts on next 'tau restart'). Match by name or
                              id prefix.
  workspace cd <name|id>      cd into the copy, or the source for --live (needs tau.fish)

Sessions (container must be running):
  session new [NAME]          start a Pi conversation and attach (NAME optional, else random)
  session list                name, type, created, last active
  session kill <name>         kill by name (or unique prefix)
  session attach <name>       reattach by name (or unique prefix)

Detach with Ctrl-b d — Pi keeps running.

Env:
  PI_AWS_PROFILE   readonly-scoped AWS profile (optional; set to use AWS inside the container)
  PI_CMD           command that starts a Pi conversation (default: pi)
  AWS_REGION       default: us-east-1
  PI_SCRIPTS / PI_WORKSPACE / PI_CONFIG   host dirs bind-mounted into the container
                   (scripts, /workspace, ~/.pi)
  PI_SKILLS_CONF   path to skills.conf (default: alongside this script)
  EDITOR           used by `tau env` / `tau config` / `tau skills`
EOF
}

die()  { echo "tau: $*" >&2; exit 1; }

# uuidgen (macOS, util-linux) with a Linux kernel fallback.
gen_uuid() { uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid; }

# Portable epoch -> human time. BSD `date -r N` (macOS) vs GNU `date -d @N` (Linux).
fmt_epoch() { date -r "$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M:%S'; }
exists()  { docker container inspect "$CONTAINER" &>/dev/null; }
running() { [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" == true ]]; }
need_running() { running || die "container not running — 'tau start' first"; }

# docker exec wrappers.
dexec()  { docker exec "$CONTAINER" "$@"; }              # non-interactive
dexeci() { docker exec -it "$CONTAINER" "$@"; }          # interactive (tty)
tx()     { dexec "${TMUX[@]}" "$@"; }                    # tmux, non-interactive

# Resolve fresh temp creds on the host and pipe them into the container tmpfs.
refresh_creds() {
  if [[ -z "$PROFILE" ]]; then
    echo "tau: PI_AWS_PROFILE not set — skipping AWS credential push (set it to use AWS inside the container)" >&2
    return 0
  fi
  local creds
  if ! creds="$(aws configure export-credentials --profile "$PROFILE" --format env 2>/dev/null)"; then
    echo "tau: could not export creds for profile '$PROFILE'." >&2
    die "if it's SSO, log in first:  aws sso login --profile $PROFILE"
  fi
  eval "$creds"   # sets AWS_ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _SESSION_TOKEN
  printf '[default]\naws_access_key_id=%s\naws_secret_access_key=%s\naws_session_token=%s\n' \
    "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY" "$AWS_SESSION_TOKEN" \
    | docker exec -i "$CONTAINER" sh -c "umask 077; cat > '$CRED_FILE'"
}

# tmpfs mounts root-owned; hand it to pi so the cred file can be written.
init_container() {
  docker exec -u 0 "$CONTAINER" chown 1000:1000 "$CRED_DIR"
  refresh_creds
}

# Read skills.conf into a docker -v arg list. Each host dir mounts read-write
# at /home/pi/.pi/agent/skills/<basename> (nested under the pi-config mount) so
# Pi can edit its own skills. Edits write back to the host source path.
# New skills Pi creates land in pi-config/agent/skills (tau-owned, not a source).
# Sets the global array `skill_mounts`.
build_skill_mounts() {
  skill_mounts=()
  [[ -f "$SKILLS_CONF" ]] || return 0
  local line
  while IFS= read -r line; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$line" ]] && continue
    line="${line/#\~/$HOME}"
    if [[ ! -d "$line" ]]; then
      echo "tau: skill path not found, skipping: $line" >&2
      continue
    fi
    skill_mounts+=(-v "$line:/home/pi/.pi/agent/skills/$(basename "$line")")
  done < "$SKILLS_CONF"
}

# Live workspaces: bind-mount the real source at /workspace/<name>, layered on top
# of the /workspace bind mount. Mounts are fixed at run time, so live add/remove
# applies on the next 'tau restart' — same rule as skills.conf.
build_live_ws_mounts() {
  live_ws_mounts=()
  [[ -f "$WORKSPACES_FILE" ]] || return 0
  local uuid name src mode
  while IFS=$'\t' read -r uuid name src mode; do
    [[ -n "$uuid" ]] || continue
    [[ "${mode:-copy}" == live ]] || continue
    [[ -d "$src" ]] || { echo "tau: live workspace source not found, skipping: $name -> $src" >&2; continue; }
    live_ws_mounts+=(-v "$src:/workspace/$name")
  done < "$WORKSPACES_FILE"
}

# The tmux session_name IS the name (no uuids). Resolve an exact name, else a
# unique prefix. Echoes the matched session_name.
resolve_session() {
  local q="$1" names match
  names="$(tx list-sessions -F '#{session_name}' 2>/dev/null || true)"
  [[ -n "$names" ]] || die "no active sessions"
  if grep -qx -- "$q" <<<"$names"; then echo "$q"; return; fi          # exact
  match="$(grep -- "^$q" <<<"$names" || true)"                          # prefix
  [[ -n "$match" ]] || die "no session matching '$q'"
  [[ "$(wc -l <<<"$match")" -eq 1 ]] || die "ambiguous '$q' — matches multiple sessions"
  echo "$match"
}

# Print stdin as an aligned table. Each line is a row; columns are split on the
# single-character delimiter ($1, usually a tab). Column widths auto-size to the
# widest value, so long names no longer overflow into the next column. Pure
# bash — no `column`, portable across macOS/Linux.
print_table() {
  local delim="$1" row i w ncol=0
  local -a data widths
  while IFS= read -r row; do
    data+=("$row")
    local -a cols; IFS="$delim" read -ra cols <<<"$row"
    for ((i = 0; i < ${#cols[@]}; i++)); do
      w=${#cols[i]}
      if (( w > ${widths[i]:-0} )); then widths[i]=$w; fi
    done
    if (( ${#cols[@]} > ncol )); then ncol=${#cols[@]}; fi
  done
  local line
  for row in "${data[@]}"; do
    local -a cols; IFS="$delim" read -ra cols <<<"$row"
    line=""
    for ((i = 0; i < ncol; i++)); do
      printf -v line '%s%-*s  ' "$line" "${widths[i]:-0}" "${cols[i]:-}"
    done
    printf '%s\n' "${line%  }"
  done
}

# Always a fresh `docker run` — `docker start`/`restart` reuse the old config and
# would NOT pick up .env, -e, or mount changes. A stopped container has no live
# sessions or creds, so recreating loses nothing.
create_container() {
  exists && docker rm -f "$CONTAINER" >/dev/null
  local env_file_args=()
  [[ -f "$SELF/.env" ]] && env_file_args+=(--env-file "$SELF/.env")
  local gitconfig_args=()
  [[ -f "$SELF/.gitconfig" ]] && gitconfig_args+=(-v "$SELF/.gitconfig:/home/pi/.gitconfig:ro")
  mkdir -p "$SCRIPTS" "$WORKSPACE" "$PI_CONFIG/agent/skills"
  local skill_mounts; build_skill_mounts
  local live_ws_mounts; build_live_ws_mounts
  docker run -d --name "$CONTAINER" \
    --tmpfs "$CRED_DIR:mode=0700" \
    -e AWS_REGION="$REGION" \
    "${env_file_args[@]+"${env_file_args[@]}"}" \
    -v "$WORKSPACE":/workspace \
    -v "$SCRIPTS":/home/pi/scripts \
    -v "$PI_CONFIG":/home/pi/.pi \
    "${gitconfig_args[@]+"${gitconfig_args[@]}"}" \
    "${skill_mounts[@]+"${skill_mounts[@]}"}" \
    "${live_ws_mounts[@]+"${live_ws_mounts[@]}"}" \
    "$IMAGE" >/dev/null
  init_container
}

cmd_start() {
  running && { echo "already running"; return; }
  create_container
  echo "started"
}

cmd_stop() {
  exists || { echo "not running"; return; }
  docker rm -f "$CONTAINER" >/dev/null
  echo "stopped (sessions lost)"
}

cmd_restart() {
  running || { echo "not running — noop"; return; }
  create_container
  echo "restarted (previous sessions were lost)"
}

cmd_shell() { need_running; refresh_creds; exec docker exec -it "$CONTAINER" zsh; }

cmd_refresh() { need_running; refresh_creds; [[ -n "$PROFILE" ]] && echo "creds refreshed"; }

cmd_env() {
  [[ -f "$SELF/.env" ]] || cp "$SELF/.env.example" "$SELF/.env"
  exec "${EDITOR:-vi}" "$SELF/.env"
}

# Edit Pi's global settings. Bind-mounted, so edits are live; Pi loads them at
# session start, so new sessions pick them up (a running conversation won't).
cmd_config() {
  mkdir -p "$PI_CONFIG/agent"
  local f="$PI_CONFIG/agent/settings.json"
  [[ -f "$f" ]] || echo '{}' > "$f"
  exec "${EDITOR:-vi}" "$f"
}

# Edit the list of host skill dirs mounted into Pi. Recreate the container
# (tau stop && tau start) to apply adds/removes — mounts are fixed at run time.
cmd_skills() {
  case "${1:-}" in
    list) local skill_mounts i; build_skill_mounts
          for ((i = 1; i < ${#skill_mounts[@]}; i += 2)); do echo "${skill_mounts[i]}"; done ;;
    *)    [[ -f "$SKILLS_CONF" ]] || cp "$SELF/skills.conf.example" "$SKILLS_CONF" 2>/dev/null || true
          exec "${EDITOR:-vi}" "$SKILLS_CONF" ;;
  esac
}

# Workspaces come in two modes:
#   copy (default) — cloned under $WORKSPACE (filesystem clone where supported,
#     e.g. macOS APFS clonefile; else a real recursive copy). $WORKSPACE is bind-mounted live at
#     /workspace, so a new copy is visible instantly with no recreate. The source is
#     never modified; agent edits land only in the copy. Re-adding a copy merges
#     source changes in via rsync (copy-only files kept).
#   live — a second bind mount (-v <src>:/workspace/<name>) layered on top of
#     /workspace, so the agent reads/writes your real source directly. Shared and
#     bidirectional, but no isolation: the agent can edit or delete your source.
#     Adding/removing changes mounts, so it applies on the next 'tau restart'
#     (running sessions are lost) — same rule as skills.conf.
# Registry line: <uuid>\t<name>\t<source>\t<mode>  (mode omitted => copy, for
#   backward compat with pre-existing 3-field entries).
ws_add() {
  local dir="" name="" mode=copy
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cd)   shift ;;                     # handled by the shell wrapper
      --live) mode=live; shift ;;
      --name) name="${2:-}"; shift 2 ;;
      *)      dir="$1"; shift ;;
    esac
  done
  dir="${dir:-$PWD}"
  local abs dest exist exist_src exist_mode
  abs="$(cd "$dir" 2>/dev/null && pwd)" || die "no such directory: $dir"
  name="${name:-$(basename "$abs")}"       # default: the dir's basename
  [[ "$name" == *[!a-zA-Z0-9_.-]* ]] && die "workspace name must be [a-zA-Z0-9_.-]: '$name'"
  dest="$WORKSPACE/$name"
  mkdir -p "$WORKSPACE"; touch "$WORKSPACES_FILE"
  exist="$(awk -F'\t' -v n="$name" '$2==n{print $3"\t"($4==""?"copy":$4)}' "$WORKSPACES_FILE")"
  exist_src="${exist%%$'\t'*}"; exist_mode="${exist##*$'\t'}"
  if [[ -n "$exist_src" ]]; then
    [[ "$exist_src" != "$abs" ]] && die "workspace '$name' already exists from a different source ($exist_src) — remove it or pass a different --name"
    [[ "$exist_mode" != "$mode" ]] && die "workspace '$name' is already $exist_mode — remove it first to change mode"
  fi
  if [[ "$mode" == live ]]; then
    if [[ -z "$exist_src" ]]; then
      local uuid; uuid="$(gen_uuid | tr 'A-Z' 'a-z')"
      printf '%s\t%s\t%s\t%s\n' "$uuid" "$name" "$abs" "$mode" >> "$WORKSPACES_FILE"
      echo "tau: added live workspace $name (${uuid%%-*}) -> /workspace/$name (your real source)" >&2
    else
      echo "tau: live workspace $name already registered" >&2
    fi
    echo "tau: WARNING: --live mounts your real source read/write; the agent can edit or delete it" >&2
    if running; then echo "tau: applies on next 'tau restart' (running sessions will be lost)" >&2
    else echo "tau: applies on next 'tau start'" >&2; fi
    echo "$abs"   # stdout: host source path, for the shell wrapper's --cd
  else
    if [[ -z "$exist_src" ]]; then
      rm -rf "$dest"                       # clean target (leftover guard)
      # Clone where the filesystem supports it (macOS APFS clonefile via `cp
      # -c`); fall back to a plain recursive copy on Linux / non-APFS.
      if ! cp -cR "$abs" "$dest" 2>/dev/null; then
        rm -rf "$dest"; cp -aR "$abs" "$dest" >&2 || die "copy failed"
      fi
      local uuid; uuid="$(gen_uuid | tr 'A-Z' 'a-z')"
      printf '%s\t%s\t%s\t%s\n' "$uuid" "$name" "$abs" "$mode" >> "$WORKSPACES_FILE"
      echo "tau: added workspace $name (${uuid%%-*}) -> /workspace/$name" >&2
    else
      rsync -a "$abs/" "$dest/" >&2 || die "rsync failed"   # merge refresh, keeps copy-only files
      echo "tau: refreshed workspace $name -> /workspace/$name" >&2
    fi
    echo "$dest"   # stdout: host path of the copy, for the shell wrapper's --cd
  fi
}

ws_list() {
  { [[ -f "$WORKSPACES_FILE" && -s "$WORKSPACES_FILE" ]]; } || { echo "no workspaces"; return; }
  local uuid name src mode
  {
    printf 'NAME\tID\tMODE\tCONTAINER\tSOURCE\n'
    while IFS=$'\t' read -r uuid name src mode; do
      [[ -n "$uuid" ]] || continue
      [[ -n "$mode" ]] || mode=copy
      printf '%s\t%s\t%s\t%s\t%s\n' "$name" "${uuid%%-*}" "$mode" "/workspace/$name" "$src"
    done < "$WORKSPACES_FILE"
  } | print_table $'\t'
}

ws_lookup() {   # echo the registry line matching a name (exact) or uuid prefix, or die
  local q="$1" line
  line="$(awk -F'\t' -v q="$q" '$2==q' "$WORKSPACES_FILE")"                    # exact name
  [[ -n "$line" ]] || line="$(awk -F'\t' -v q="$q" 'index($1,q)==1' "$WORKSPACES_FILE")"  # uuid prefix
  [[ -n "$line" ]] || die "no workspace matching '$q'"
  [[ "$(wc -l <<<"$line")" -eq 1 ]] || die "ambiguous '$q'"
  printf '%s\n' "$line"
}

ws_remove() {
  [[ -n "${1:-}" ]] || die "usage: tau workspace remove <name|id>"
  { [[ -f "$WORKSPACES_FILE" && -s "$WORKSPACES_FILE" ]]; } || die "no workspaces"
  local line uuid name mode tmp
  line="$(ws_lookup "$1")"
  uuid="$(printf '%s' "$line" | cut -f1)"; name="$(printf '%s' "$line" | cut -f2)"
  mode="$(printf '%s' "$line" | cut -f4)"; [[ -n "$mode" ]] || mode=copy
  if [[ "$mode" == live ]]; then
    echo "tau: unmounts $name on next 'tau restart' (source untouched)" >&2
  else
    rm -rf "${WORKSPACE:?}/$name"
    echo "tau: removed $name (${uuid%%-*}) — source left untouched (copy + any agent edits deleted)" >&2
  fi
  tmp="$(mktemp)"; awk -F'\t' -v u="$uuid" '$1!=u' "$WORKSPACES_FILE" > "$tmp" && mv "$tmp" "$WORKSPACES_FILE"
}

ws_cd() {   # print the workspace's host path to stdout; the shell wrapper cds to it
  { [[ -f "$WORKSPACES_FILE" && -s "$WORKSPACES_FILE" ]]; } || die "no workspaces"
  local line name src mode
  if [[ -z "${1:-}" ]]; then
    [[ "$(grep -c . "$WORKSPACES_FILE")" -eq 1 ]] || die "usage: tau workspace cd <name|id>"
    line="$(grep . "$WORKSPACES_FILE" | head -1)"
  else
    line="$(ws_lookup "$1")"
  fi
  name="$(printf '%s' "$line" | cut -f2)"
  src="$(printf '%s' "$line" | cut -f3)"
  mode="$(printf '%s' "$line" | cut -f4)"; [[ -n "$mode" ]] || mode=copy
  if [[ "$mode" == live ]]; then printf '%s\n' "$src"; else printf '%s\n' "$WORKSPACE/$name"; fi
}

cmd_workspace() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    add)       ws_add "$@" ;;
    list|ls)   ws_list ;;
    remove|rm) ws_remove "$@" ;;
    cd)        ws_cd "$@" ;;
    *) die "usage: tau workspace {add [dir] [--name NAME] [--cd] [--live]|list|remove <name|id>|cd <name|id>}" ;;
  esac
}

cmd_session() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new)
      need_running
      local name=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --name) name="${2:-}"; shift 2 ;;
          -*) die "unknown flag: $1" ;;
          *) name="$1"; shift ;;              # positional name: `tau session new foo`
        esac
      done
      refresh_creds
      name="${name:-$(gen_uuid | tr 'A-Z' 'a-z' | cut -c1-8)}"   # default: short random name
      [[ "$name" == *[!a-zA-Z0-9_-]* ]] && die "session name must be [a-zA-Z0-9_-] (no . or :): '$name'"
      tx has-session -t "=$name" 2>/dev/null && die "session '$name' already exists"
      tx new-session -d -s "$name" "$PI_CMD"
      echo "session $name started"
      exec docker exec -it "$CONTAINER" "${TMUX[@]}" attach -t "=$name"
      ;;
    list)
      need_running
      local rows
      rows="$(tx list-sessions -F '#{session_name}|#{session_created}|#{session_activity}' 2>/dev/null || true)"
      [[ -n "$rows" ]] || { echo "no active sessions"; return; }
      {
        printf 'NAME\tTYPE\tCREATED\tLAST ACTIVE\n'
        while IFS='|' read -r name created activity; do
          local type=session
          [[ "$name" == sa-* ]] && type=subagent   # pi's subagent naming convention
          printf '%s\t%s\t%s\t%s\n' "$name" "$type" \
            "$(fmt_epoch "$created")" \
            "$(fmt_epoch "$activity")"
        done <<<"$rows"
      } | print_table $'\t'
      ;;
    kill)
      need_running
      [[ -n "${1:-}" ]] || die "usage: tau session kill <name|id>"
      local full; full="$(resolve_session "$1")"
      tx kill-session -t "=$full"
      echo "killed $full"
      ;;
    attach)
      need_running
      [[ -n "${1:-}" ]] || die "usage: tau session attach <name|id>"
      refresh_creds
      local full; full="$(resolve_session "$1")"
      exec docker exec -it "$CONTAINER" "${TMUX[@]}" attach -t "=$full"
      ;;
    *) die "usage: tau session {new [--name NAME]|list|kill <name>|attach <name>}" ;;
  esac
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    shell)   cmd_shell "$@" ;;
    refresh) cmd_refresh "$@" ;;
    env)     cmd_env "$@" ;;
    config)  cmd_config "$@" ;;
    skills)  cmd_skills "$@" ;;
    workspace) cmd_workspace "$@" ;;
    session) cmd_session "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

main "$@"
